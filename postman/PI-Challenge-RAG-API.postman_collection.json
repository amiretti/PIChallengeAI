    {
      "name": "Requisitos de la respuesta",
      "description": "Comprobaciones de los requisitos que no se ven en una sola respuesta aislada.",
      "item": [
        {
          "name": "Determinismo — misma pregunta, otro usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// El requisito es que la misma pregunta se responda siempre exactamente",
                  "// igual. Se repite con otro user_name para comprobar además que el nombre",
                  "// del usuario no influye en la respuesta.",
                  "pm.test('Devuelve exactamente la misma respuesta que la primera vez', function () {",
                  "    var first = pm.collectionVariables.get('zaraAnswer');",
                  "    pm.expect(first, 'Ejecutar antes el request «¿Quién es Zara?»').to.be.a('string').and.to.have.length.above(0);",
                  "    pm.expect(pm.response.json().answer).to.eql(first);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_name\": \"Jane Roe\",\n    \"question\": \"¿Quién es Zara?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        },
        {
          "name": "Pregunta fuera del documento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var answer = pm.response.json().answer;",
                  "",
                  "// El modelo sabe quién ganó el mundial 2022. Si contesta «Argentina»,",
                  "// está respondiendo con conocimiento propio en vez de con el documento.",
                  "pm.test('No responde con conocimiento propio del modelo', function () {",
                  "    pm.expect(answer).to.not.match(/argentina/i);",
                  "});",
                  "",
                  "pm.test('Indica que el documento no cubre la pregunta', function () {",
                  "    pm.expect(answer).to.match(/\\bno\\b/i);",
                  "});",
                  "",
                  "pm.test('Sigue respetando el formato de una sola oración', function () {",
                  "    var terminators = answer.match(/[.!?\\u2026](\\s|$)/g) || [];",
                  "    pm.expect(terminators.length).to.be.at.most(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_name\": \"John Doe\",\n    \"question\": \"¿Quién ganó el mundial 2022?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
