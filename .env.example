# Copiar este archivo como `.env` y completar los valores reales.
# El archivo `.env` está en .gitignore y NUNCA debe subirse al repositorio.

# --- Cohere ---
# Obtener en https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Modelo de embeddings. Debe ser multilingüe: el documento está en español
# y las preguntas pueden llegar en inglés o portugués.
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# Modelo de chat que redacta la respuesta final.
COHERE_CHAT_MODEL=command-a-03-2025

# --- RAG ---
# Ruta al documento que se indexa al iniciar la aplicación.
DOCUMENT_PATH=data/documento.docx

# Cantidad de chunks a recuperar por consulta.
TOP_K=1

# Temperatura del LLM. 0 = determinista (requisito del challenge).
LLM_TEMPERATURE=0

# true  = responde únicamente con lo que dice el documento (comportamiento del challenge).
# false = el documento sigue teniendo prioridad, pero si no cubre la pregunta el modelo
#         puede responder con su propio conocimiento.
RESTRICT_TO_DOCUMENT=true
